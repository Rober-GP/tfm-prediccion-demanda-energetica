# ─────────────────────────────────────────────────────────────────────────────
# PLANTILLA DE CREDENCIALES
#
# Copia este archivo como .env y rellena los valores:
#     cp .env.example .env
#
# El archivo .env está excluido en .gitignore y NO debe subirse al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# AEMET OpenData — obligatoria para las variables meteorológicas
# Solicítala en: https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# ESIOS (Red Eléctrica) — opcional
# La demanda horaria se obtiene de la API REData, que no requiere token.
# ESIOS ofrece más indicadores (precio spot, demanda prevista).
# Solicítalo escribiendo a consultasios@ree.es
ESIOS_TOKEN=
